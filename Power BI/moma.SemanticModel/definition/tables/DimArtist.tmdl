	partition DimArtist = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProcessedFolder & "\DimArtist.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Headers = Table.TransformColumnNames(Promoted, each Text.Replace(_, "#(feff)", "")),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"BirthYear", "DeathYear", "BirthDecade"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"ArtistKey", Int64.Type}, {"ArtistName", type text}, {"Nationality", type text}, {"Gender", type text}, {"NationalityGroup", type text}, {"LifeStatus", type text}, {"HasWikidata", type logical}, {"HasULAN", type logical}, {"ArtistBio", type text}, {"BirthYear", Int64.Type}, {"DeathYear", Int64.Type}, {"BirthDecade", Int64.Type}, {"BirthYearLabel", type text}, {"DeathYearLabel", type text}, {"BirthDecadeLabel", type text}}, "en-US")
				in
				    Typed

