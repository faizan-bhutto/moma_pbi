table DimMediumGroup
	lineageTag: 3a795267-e020-4de0-81af-9bb4c6e16ef0

	column MediumGroupKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c68a069a-943a-4d13-96a9-34d96954dd41
		summarizeBy: none
