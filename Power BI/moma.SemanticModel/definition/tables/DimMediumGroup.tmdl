		summarizeBy: none
		sourceColumn: MediumGroup
		sortByColumn: MediumGroupKey

	partition DimMediumGroup = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProcessedFolder & "\DimMediumGroup.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Headers = Table.TransformColumnNames(Promoted, each Text.Replace(_, "#(feff)", "")),
				    Typed = Table.TransformColumnTypes(Headers, {{"MediumGroupKey", Int64.Type}, {"MediumGroup", type text}}, "en-US")
				in
				    Typed

